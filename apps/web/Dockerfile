# ==============================================================================
# Production Multi-Stage Dockerfile: apps/web
# Next.js 15 Standalone Output (<350MB VPS footprint, ~130MB total)
# Monorepo: Compatible with pnpm / npm
# Base: Alpine Linux (Node.js 20 LTS)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base Alpine Environment
# ------------------------------------------------------------------------------
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat dumb-init
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate

# ------------------------------------------------------------------------------
# Stage 2: Install Monorepo Dependencies
# ------------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app

# Copy package manifests
COPY package.json ./
# If pnpm-lock.yaml exists, use it; otherwise fallback to npm
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else npm install; fi

# ------------------------------------------------------------------------------
# Stage 3: Build Standalone Bundle
# ------------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN if [ -f pnpm-lock.yaml ]; then pnpm run build; else npm run build; fi

# ------------------------------------------------------------------------------
# Stage 4: Hardened Minimal Production Runner (<350MB Target)
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
RUN apk add --no-cache dumb-init
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME="0.0.0.0" \
    NEXT_TELEMETRY_DISABLED=1

# Create unprivileged system group & user (UID 1001)
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy public assets and standalone output
COPY --from=builder /app/public ./public

# Automatically copy standalone output files
# Handles both root and sub-app output paths generated by Next.js output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Permissions check
USER 1001:1001

EXPOSE 3000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "server.js"]
